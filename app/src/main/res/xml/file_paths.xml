<?xml version="1.0" encoding="utf-8"?>
<!--
    Covers RustDeskSessionService's ft_download_<jobId> temp files, which live directly in
    this app's internal files/ root (File(filesDir, "ft_download_$jobId")) — see
    IRustDeskFileTransferSession.downloadFile's doc for why the main app sometimes needs a
    content:// Uri onto one of these instead of it being finalized into MediaStore.Downloads.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="ft_downloads" path="." />
    <!-- "Submit Logs" (InfoActivity) writes its anonymized copy here before sharing.
         Scoped to the subdirectory, not the whole cache root: the main app narrowed its own
         provider the same way (audit H4) so a FileProvider can never hand out a cache file that
         merely happens to be there. -->
    <cache-path name="shared_logs" path="shared_logs/" />
</paths>
